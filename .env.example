# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Hostnames below refer to the docker-compose service names and resolve
# automatically inside the Compose network.

# --- GitHub ---
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_CALLBACK_SECRET=your_github_oauth_callback_secret

# --- RabbitMQ ---
RABBITMQ_URL=amqp://user:password@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_ERLANG_COOKIE=change_me_to_a_random_string

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=github_meta

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_DB=default

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Qdrant (vector database) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Recommendation engine ---
LAST_UPDATE_CUT=24 months
SIMILARITY_LIST_SIZE=200

# --- Embedding autoscaler ---
EMBEDDING_API_MAX_INSTANCES=3
EMBEDDING_API_IDLE_TIMEOUT=600
COMPOSE_PROJECT_NAME=github-trending

# --- Twitter/X social poster (optional) ---
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Misc ---
DEBUG=false
# Set to "true" when running services directly on the host (outside Docker).
LOCAL_ENV=false
